# Настройки бэкенда. На сервере лежат в /etc/wedding-bot.env (права 600).

# Токен бота от @BotFather
BOT_TOKEN=

# Код, по которому молодожены становятся администраторами: /admin <код> в боте
ADMIN_CODE=

# Необязательно: id администраторов через запятую (если известны заранее)
ADMIN_IDS=

# Часовой пояс для времени в уведомлениях (Оренбург = UTC+5)
TZ_NAME=Asia/Yekaterinburg
